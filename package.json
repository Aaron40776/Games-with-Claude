{
  "name": "riftdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Riftdeck – a roguelite deckbuilder set in the Riftline universe.",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "test": "node --test tests/*.test.js",
    "sim": "node tools/sim.js",
    "smoke": "node build.js && node tools/smoke.js",
    "e2e": "node build.js && node tools/interact.js && node tools/scenarios.js && node tools/pwa.js",
    "icons": "node tools/icons.js",
    "gallery": "node build.js && node tools/gallery.js",
    "lint": "eslint .",
    "monkey": "node build.js && node tools/monkey.js"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.2.0",
    "@fontsource/chakra-petch": "^5.2.0",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "playwright": "^1.56.1"
  }
}
